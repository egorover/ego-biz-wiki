# Application
APP_NAME=EgoBiz Wiki
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# Embeddings / OpenAI-compatible provider
OPENAI_API_KEY=
# Leave empty for direct OpenAI API usage.
# For ProxyAPI, use: https://api.proxyapi.ru/openai/v1
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# Knowledge Base / indexing
KNOWLEDGE_BASE_PATH=knowledge_base
MANIFEST_FILENAME=manifest.yaml
CHROMA_PERSIST_DIRECTORY=.chroma
CHROMA_COLLECTION=ego_biz_wiki
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=
# Streamlit UI
STREAMLIT_API_URL=http://127.0.0.1:8000
